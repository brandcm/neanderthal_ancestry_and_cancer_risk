import yaml

# =============================================================================
# Variables
# =============================================================================

python_path = "python3"

project_directory = "/wynton/group/capra/projects/neanderthal_ancestry_and_cancer_risk/"
scripts_directory = f"{project_directory}scripts/LD_score_regression/"
summary_stats_directory = f"{project_directory}data/GWAS_summary_stats/"
introgressed_variants_directory = f"{project_directory}data/introgressed_variants/"
annotation_directory = f"{project_directory}data/annotations_and_LD_scores/"
ld_score_regression_directory = f"{project_directory}data/LD_score_regression/"
sumstats_directory = f"{ld_score_regression_directory}sumstats/"
results_directory = f"{ld_score_regression_directory}results/"

# external data
ldsc_directory = "/wynton/group/capra/data/ldsc_new/"
gwas_metadata_file = f"{project_directory}data/metadata/cancer_GWAS_ldsc_sumstats_formatting_metadata.yaml"
# the fine-mapping metadata carries the case and control counts, which the
# heritability QC table reports alongside the regression diagnostics
cancer_metadata_file = f"{project_directory}data/metadata/cancer_GWAS_metadata.yaml"

# scripts
munge_sumstats_script = f"{ldsc_directory}bin/ldsc_python3/munge_sumstats.py"
make_annotation_script = f"{ldsc_directory}bin/ldsc_python3/make_annot.py"
ldsc_script = f"{ldsc_directory}bin/ldsc_python3/ldsc.py"
concat_heritability_results_script = f"{scripts_directory}concat_heritability_results.py"
summarize_heritability_qc_script = f"{scripts_directory}summarize_heritability_qc.py"

# the LDSC scripts import their own package rather than an installed one
ldsc_pythonpath = f"{ldsc_directory}bin/ldsc_python3/"

# GWAS
with open(gwas_metadata_file) as f:
    gwas_metadata = yaml.safe_load(f)

gwass = list(gwas_metadata)

# annotations and LD scores are only needed for the ancestry groups some GWAS uses
ancestry_groups = sorted({metadata["ancestry_group"] for metadata in gwas_metadata.values()})

# one annotation per introgression call method, each on its pan-ancestry call set.
# The cross-method union and intersection are not modelled, nor are the
# ancestry-specific call sets: for a given GWAS the ancestry-specific set is close to
# the subset of the pan-ancestry set segregating in that ancestry group, so the two
# estimates would largely restate each other.
variant_sets = [
    "Browning_et_al_2018",
    "Sankararaman_et_al_2016",
    "Skov_2024",
    "Vernot_et_al_2016",
]

chromosomes = [str(i) for i in range(1, 23)]

wildcard_constraints:
    gwas = "|".join(gwass),
    variant_set = "|".join(variant_sets),
    chr = "|".join(chromosomes)


def ancestry_group(wildcards):
    """Ancestry group of one GWAS."""
    return gwas_metadata[wildcards.gwas]["ancestry_group"]


def hapmap_snps(group):
    """HapMap3 variant list for one ancestry group."""
    return f"{ldsc_directory}data/HapMap3_SNPs/{group}_HapMap3_SNPs.txt.gz"


def plink_prefix(group):
    """1000 Genomes PLINK fileset prefix for one ancestry group, without the chromosome."""
    return f"{ldsc_directory}data/1000G_{group}_plink_files/1000G.{group}.QC."


def baseline_prefix(group):
    """baselineLD v2.2 LD score prefix for one ancestry group."""
    return f"{ldsc_directory}data/1000G_{group}_baselineLD_v2.2/baselineLD."


def weights_prefix(group):
    """Regression weight prefix. The EUR weights predate the others and are not ancestry-labelled."""
    if group == "EUR":
        return f"{ldsc_directory}data/1000G_EUR_weights/weights.hm3_noMHC."
    return f"{ldsc_directory}data/1000G_{group}_weights/weights.{group}.hm3_noMHC."


def ld_scores(wildcards):
    """Every chromosome's introgressed-variant LD scores for one GWAS and one call set."""
    return expand(
        f"{annotation_directory}{{group}}/{{variant_set}}_introgressed_variants.{{chr}}.l2.ldscore.gz",
        group = ancestry_group(wildcards),
        variant_set = wildcards.variant_set,
        chr = chromosomes
    )


def prevalence_flags(wildcards):
    """Liability-scale conversion, when the metadata records the prevalences.

    Observed-scale heritability depends on the case fraction of the study, so it is
    not comparable between cancers with different ascertainment. Giving LDSC both
    the sample and population prevalence makes it report the liability scale as
    well, which is. A GWAS without both recorded gets the observed scale only."""
    metadata = gwas_metadata[wildcards.gwas]
    sample = metadata.get("sample_prevalence")
    population = metadata.get("population_prevalence")
    if sample is None or population is None:
        return ""
    return f"--samp-prev {sample} --pop-prev {population}"

# =============================================================================
# Final outputs
# =============================================================================

heritability_summary = f"{results_directory}summaries/introgressed_variants_heritability_summary.txt"
heritability_qc_summary = f"{results_directory}summaries/GWAS_heritability_qc.txt"

# =============================================================================
# Rules
# Resources: mem is GB per thread (SGE h_vmem / mem_free are per slot), time is h_rt.
# =============================================================================

rule all:
    input:
        heritability_summary,
        heritability_qc_summary

# --- summary statistics ---

rule format_summary_stats:
    input:
        summary_stats = f"{summary_stats_directory}{{gwas}}.txt.gz"
    output:
        log = f"{sumstats_directory}{{gwas}}.log",
        sumstats = f"{sumstats_directory}{{gwas}}.sumstats.gz"
    params:
        python = python_path,
        script = munge_sumstats_script,
        hapmap_snps = lambda wildcards: hapmap_snps(ancestry_group(wildcards)),
        extra_flags = lambda wildcards: gwas_metadata[wildcards.gwas]["extra_flags"],
        out_prefix = f"{sumstats_directory}{{gwas}}"
    threads: 1
    resources:
        mem = 4,
        time = "1:00:00"
    shell:
        """
        {params.python} {params.script} \
            --sumstats {input.summary_stats} \
            --out {params.out_prefix} \
            --merge-alleles {params.hapmap_snps} \
            {params.extra_flags}
        """

# --- annotations and LD scores ---

rule generate_annotations_and_ld_scores:
    input:
        bim = f"{ldsc_directory}data/1000G_{{group}}_plink_files/1000G.{{group}}.QC.{{chr}}.bim",
        bed = f"{introgressed_variants_directory}{{variant_set}}_introgressed_variants_hg19.bed"
    output:
        annotation = f"{annotation_directory}{{group}}/{{variant_set}}_introgressed_variants.{{chr}}.annot.gz",
        ld_scores = f"{annotation_directory}{{group}}/{{variant_set}}_introgressed_variants.{{chr}}.l2.ldscore.gz"
    params:
        python = python_path,
        make_annotation = make_annotation_script,
        ldsc = ldsc_script,
        pythonpath = ldsc_pythonpath,
        plink_prefix = lambda wildcards: f"{plink_prefix(wildcards.group)}{wildcards.chr}",
        hapmap_snps = lambda wildcards: hapmap_snps(wildcards.group),
        out_prefix = f"{annotation_directory}{{group}}/{{variant_set}}_introgressed_variants.{{chr}}"
    threads: 1
    resources:
        mem = 10,
        time = "2:00:00"
    shell:
        """
        export PYTHONPATH="{params.pythonpath}"

        {params.python} {params.make_annotation} \
            --bed-file {input.bed} \
            --bimfile {input.bim} \
            --annot-file {output.annotation} \
            --annot_name {wildcards.variant_set}

        {params.python} {params.ldsc} \
            --l2 \
            --bfile {params.plink_prefix} \
            --ld-wind-cm 1 \
            --annot {output.annotation} \
            --thin-annot \
            --print-snps {params.hapmap_snps} \
            --out {params.out_prefix}
        """

# --- total heritability and regression diagnostics ---
#
# One run per GWAS under the baselineLD model with no introgression annotation.
# This is where lambda GC, the mean chi-square, the LDSC intercept and the total
# heritability come from.
#
# They are deliberately not taken from the partitioned runs below: each of those
# adds one annotation and so re-estimates all four, giving one value per variant
# set rather than one per GWAS. The differences are small -- intercepts of 0.9287,
# 0.9285 and 0.9280 for the same study -- but a table needs one number per row.
#
# Using baselineLD rather than a univariate fit also means the reported intercept
# and heritability come from the same model as every enrichment in the paper, so a
# reader reconstructing them gets these numbers. The regression weights cannot
# serve as reference LD scores here in any case: they ship no .l2.M_5_50 files,
# since they are weights rather than an annotation.
#
# ldsc.py --h2 without --overlap-annot writes only a log, so the log is the output.

rule calculate_total_heritability:
    input:
        sumstats = f"{sumstats_directory}{{gwas}}.sumstats.gz"
    output:
        log = f"{results_directory}{{gwas}}_total_h2.log"
    params:
        python = python_path,
        ldsc = ldsc_script,
        pythonpath = ldsc_pythonpath,
        baseline_prefix = lambda wildcards: baseline_prefix(ancestry_group(wildcards)),
        weights_prefix = lambda wildcards: weights_prefix(ancestry_group(wildcards)),
        prevalence = prevalence_flags,
        out_prefix = f"{results_directory}{{gwas}}_total_h2"
    threads: 1
    resources:
        mem = 10,
        time = "1:00:00"
    shell:
        """
        export PYTHONPATH="{params.pythonpath}"

        {params.python} {params.ldsc} \
            --h2 {input.sumstats} \
            --ref-ld-chr {params.baseline_prefix} \
            --w-ld-chr {params.weights_prefix} \
            {params.prevalence} \
            --out {params.out_prefix}
        """

rule summarize_heritability_qc:
    input:
        logs = expand(f"{results_directory}{{gwas}}_total_h2.log", gwas = gwass),
        ldsc_metadata = gwas_metadata_file,
        cancer_metadata = cancer_metadata_file
    output:
        heritability_qc_summary
    params:
        python = python_path,
        script = summarize_heritability_qc_script
    threads: 1
    resources:
        mem = 2,
        time = "0:30:00"
    shell:
        """
        {params.python} {params.script} \
            --logs {input.logs} \
            --ldsc_metadata {input.ldsc_metadata} \
            --cancer_metadata {input.cancer_metadata} \
            --output {output}
        """

# --- partitioned heritability ---

rule calculate_heritability:
    input:
        sumstats = f"{sumstats_directory}{{gwas}}.sumstats.gz",
        ld_scores = ld_scores
    output:
        log = f"{results_directory}{{gwas}}_{{variant_set}}.log",
        results = f"{results_directory}{{gwas}}_{{variant_set}}.results"
    params:
        python = python_path,
        ldsc = ldsc_script,
        pythonpath = ldsc_pythonpath,
        baseline_prefix = lambda wildcards: baseline_prefix(ancestry_group(wildcards)),
        introgression_prefix = lambda wildcards: (
            f"{annotation_directory}{ancestry_group(wildcards)}/"
            f"{wildcards.variant_set}_introgressed_variants."
        ),
        weights_prefix = lambda wildcards: weights_prefix(ancestry_group(wildcards)),
        frq_prefix = lambda wildcards: plink_prefix(ancestry_group(wildcards)),
        out_prefix = f"{results_directory}{{gwas}}_{{variant_set}}"
    threads: 1
    resources:
        mem = 10,
        time = "2:00:00"
    shell:
        """
        export PYTHONPATH="{params.pythonpath}"

        {params.python} {params.ldsc} \
            --h2 {input.sumstats} \
            --ref-ld-chr {params.baseline_prefix},{params.introgression_prefix} \
            --w-ld-chr {params.weights_prefix} \
            --overlap-annot \
            --frqfile-chr {params.frq_prefix} \
            --out {params.out_prefix}
        """

rule concat_heritability_results:
    input:
        results = expand(
            f"{results_directory}{{gwas}}_{{variant_set}}.results",
            gwas = gwass,
            variant_set = variant_sets
        )
    output:
        heritability_summary
    params:
        python = python_path,
        script = concat_heritability_results_script,
        variant_sets = " ".join(variant_sets)
    threads: 1
    resources:
        mem = 2,
        time = "0:30:00"
    shell:
        """
        {params.python} {params.script} \
            --results {input.results} \
            --variant_sets {params.variant_sets} \
            --output {output}
        """
