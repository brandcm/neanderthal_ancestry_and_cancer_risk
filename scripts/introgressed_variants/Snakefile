import glob

# =============================================================================
# Variables
# =============================================================================

python_path = "python3"

project_directory = "/wynton/group/capra/projects/neanderthal_ancestry_and_cancer_risk/"
scripts_directory = f"{project_directory}scripts/introgressed_variants/"
introgressed_variants_directory = f"{project_directory}data/introgressed_variants/"
tmp_directory = f"{introgressed_variants_directory}tmp/"      # intermediates, removed by Snakemake after use
logs_directory = f"{introgressed_variants_directory}logs/"    # liftOver records of unconverted positions

# external data
data_directory = "/wynton/group/capra/data/"
sankararaman_directory = f"{data_directory}Sankararaman_et_al_2016_introgressed_variants/1/neandertal"
skov_directory = f"{data_directory}Skov_2024_introgressed_variants/"
vernot_directory = f"{data_directory}Vernot_et_al_2016_introgressed_variants/introgressed_tag_snp_frequencies/"
vernot_beds = sorted(glob.glob(f"{vernot_directory}all_tag_snps.*.merged.ALL.0.3_R2_cluster.1KG_phase3_essentials.bed"))
if not vernot_beds:
    raise ValueError(f"No Vernot tag SNP files found in {vernot_directory}")
rsid_dictionary = f"{data_directory}gnomAD_v2.1.1_PASS_SNVs_chr_pos_rsID_mapping/gnomAD_v2.1.1_PASS_SNVs_chr{{chr}}_pos_rsIDs.pkl.gz"
gnomad_vcf = f"{data_directory}gnomAD_v4.1.0_PASS_unsplit_SNVs/gnomAD_v4.1.0_chr{{chr}}_PASS_unsplit_SNVs.vcf.gz"
liftover = "/wynton/group/capra/bin/liftOver/liftOver"
hg38_to_hg19_chain = "/wynton/group/capra/bin/liftOver/hg38ToHg19.over.chain.gz"

# scripts
rsid_mapping_script = f"{scripts_directory}rsid_mapping.py"
merge_script = f"{scripts_directory}merge_introgressed_variants.py"
mafs_script = f"{scripts_directory}quantify_introgressed_variant_mafs.py"

sets = ["Browning_et_al_2018", "Sankararaman_et_al_2016", "Skov_2024", "Vernot_et_al_2016"]
rsid_mapping_sets = ["Sankararaman_et_al_2016", "Skov_2024", "Vernot_et_al_2016"]
chrs = [str(i) for i in range(1, 23)]

# per-map variant files (Browning is provided, the others are built below)
browning_variants = f"{introgressed_variants_directory}Browning_et_al_2018_introgressed_variants_hg19.txt"
sankararaman_variants = f"{introgressed_variants_directory}Sankararaman_et_al_2016_introgressed_variants_hg19.txt"
skov_variants = f"{introgressed_variants_directory}Skov_2024_introgressed_variants_hg19.txt"
vernot_variants = f"{introgressed_variants_directory}Vernot_et_al_2016_introgressed_variants_hg19.txt"

# =============================================================================
# Final outputs
# =============================================================================

skov_regions = f"{introgressed_variants_directory}Skov_2024_introgressed_regions_hg19.bed"

variant_outputs = expand(
    f"{introgressed_variants_directory}{{set}}_introgressed_variants_hg19.{{ext}}",
    set = sets,
    ext = ["txt", "bed"]
) + [
    f"{introgressed_variants_directory}intersection_introgressed_variants_hg19.bed",
    f"{introgressed_variants_directory}union_introgressed_variants_hg19.bed"
]

merged_output = f"{introgressed_variants_directory}merged_introgressed_variants_hg19.txt"
maf_output = f"{introgressed_variants_directory}gnomAD_v4.1.0_introgressed_variant_MAFs.txt.gz"

# =============================================================================
# Rules
# Resources: mem is GB per thread (SGE h_vmem / mem_free are per slot), time is h_rt.
# =============================================================================

rule all:
    input:
        [skov_regions] + variant_outputs + [merged_output, maf_output]

# --- regions ---

rule retrieve_Skov_2024_regions:
    input:
        hgdp_segments = f"{skov_directory}hg38_HGDP_segments.txt",
        tgp_segments = f"{skov_directory}hg38_1000g_segments.txt"
    output:
        regions = skov_regions,
        unlifted = f"{logs_directory}Skov_2024_introgressed_regions_hg38.unlifted",
        hg38_tmp = temp(f"{tmp_directory}Skov_2024_introgressed_regions_hg38.tmp"),
        hg19_tmp = temp(f"{tmp_directory}Skov_2024_introgressed_regions_hg19_unmerged.tmp")
    params:
        liftover = liftover,
        chain = hg38_to_hg19_chain
    resources:
        mem = 10,
        time = "2:00:00"
    shell:
        """
        # Neanderthal or Both, posterior >= 0.8
        tail -q -n +2 {input.hgdp_segments} {input.tgp_segments} \
        | awk '$8 >= 0.8 && ($9 == "Neanderthal" || $9 == "Both") {{print $5, $6, $7}}' OFS='\\t' \
        | sort -u > {output.hg38_tmp}

        {params.liftover} {output.hg38_tmp} {params.chain} {output.hg19_tmp} {output.unlifted}

        awk '{{sub(/^chr/, "", $1); print $1, $2, $3}}' OFS='\\t' {output.hg19_tmp} \
        | sort -V -k1,1 -k2,2n | bedtools merge -i - > {output.regions}
        """

# --- variants ---

rule retrieve_Sankararaman_et_al_2016_variants:
    output:
        temp(f"{tmp_directory}Sankararaman_et_al_2016_introgressed_variants_hg19.tmp")
    params:
        data_directory = sankararaman_directory
    threads: 4
    resources:
        mem = 5,
        time = "1:30:00"
    shell:
        """
        find {params.data_directory} -name "pred.*.thresh-50.length-0.00" -exec cat {{}} + \
        | awk '!/^#/ && ($10 > 0.5) {{print $2, $4}}' OFS='\\t' \
        | sort --parallel={threads} -S 10G -u -k1,1 -k2,2n \
        > {output}
        """

rule retrieve_Skov_2024_variants:
    input:
        hgdp_snvs = f"{skov_directory}hg38_HGDP_SNPS.txt",
        tgp_snvs = f"{skov_directory}hg38_1000g_SNPS.txt"
    output:
        combined_hg38_snvs = temp(f"{tmp_directory}Skov_2024_hg38.bed"),
        unlifted = f"{logs_directory}Skov_2024_introgressed_variants_hg38.unlifted",
        unformatted_tmp = temp(f"{tmp_directory}Skov_2024_introgressed_variants_hg19_unformatted.tmp"),
        formatted_tmp = temp(f"{tmp_directory}Skov_2024_introgressed_variants_hg19.tmp")
    params:
        liftover = liftover,
        chain = hg38_to_hg19_chain
    resources:
        mem = 5,
        time = "1:00:00"
    shell:
        """
        # keep SNVs shared with a Neanderthal genome; ancestral and derived alleles ride along as extra columns
        tail -q -n +2 {input.hgdp_snvs} {input.tgp_snvs} \
        | awk '$8 ~ /(Altai|Chagyrskaya|Forbes|Goyet|HST|LesCottes|Mez1|Mez2|Scladina|Spy|Vindija|VindijaG1)/ {{print $1, $2-1, $2, $4, $5}}' OFS='\\t' \
        | sort -u > {output.combined_hg38_snvs}

        # -bedPlus=3 -tab: lift the first three columns, carry the alleles through unchanged
        {params.liftover} -bedPlus=3 -tab {output.combined_hg38_snvs} {params.chain} {output.unformatted_tmp} {output.unlifted}

        awk '{{sub(/^chr/, "", $1); print $1, $3, $4, $5}}' OFS='\\t' {output.unformatted_tmp} > {output.formatted_tmp}
        """

rule retrieve_Vernot_et_al_2016_variants:
    input:
        vernot_beds
    output:
        temp(f"{tmp_directory}Vernot_et_al_2016_introgressed_variants_hg19.tmp")
    resources:
        mem = 5,
        time = "1:00:00"
    shell:
        """
        cat {input} \
        | awk '{{sub(/^chr/, "", $1); print $1, $3, $4, $5, $14}}' OFS='\\t' \
        | sort -V -k1,1 -k2,2n | uniq > {output}
        """

# --- rsID mapping (per chromosome) ---

rule split_variants_by_chr:
    input:
        f"{tmp_directory}{{set}}_introgressed_variants_hg19.tmp"
    output:
        temp(f"{tmp_directory}{{set}}_chr{{chr}}_introgressed_variants_hg19.tmp")
    wildcard_constraints:
        set = "|".join(rsid_mapping_sets),
        chr = "|".join(chrs)
    resources:
        mem = 5,
        time = "1:00:00"
    shell:
        """
        awk -v chr={wildcards.chr} '$1 == chr {{$1 = $1; print}}' OFS='\\t' {input} > {output}
        """

rule rsid_mapping:
    input:
        variants = f"{tmp_directory}{{set}}_chr{{chr}}_introgressed_variants_hg19.tmp",
        rsid_dict = rsid_dictionary
    output:
        temp(f"{tmp_directory}{{set}}_chr{{chr}}_introgressed_variants_hg19_with_rsIDs.txt")
    wildcard_constraints:
        set = "|".join(rsid_mapping_sets),
        chr = "|".join(chrs)
    params:
        python = python_path,
        script = rsid_mapping_script
    resources:
        mem = 50,
        time = "1:00:00"
    shell:
        """
        {params.python} {params.script} \
            --input {input.variants} \
            --dict {input.rsid_dict} \
            --chr {wildcards.chr} \
            --output {output}
        """

rule concat_variants:
    input:
        lambda wildcards: expand(
            f"{tmp_directory}{wildcards.set}_chr{{chr}}_introgressed_variants_hg19_with_rsIDs.txt",
            chr = chrs
        )
    output:
        txt = f"{introgressed_variants_directory}{{set}}_introgressed_variants_hg19.txt",
        bed = f"{introgressed_variants_directory}{{set}}_introgressed_variants_hg19.bed"
    wildcard_constraints:
        set = "|".join(rsid_mapping_sets)
    resources:
        mem = 5,
        time = "1:00:00"
    shell:
        """
        cat {input} | sort -V -k1,1 -k2,2n > {output.txt}
        awk '{{print $1, $2-1, $2, ($3 ? $3 : "."), ($4 ? $4 : "."), ($5 ? $5 : ".")}}' OFS='\\t' {output.txt} \
        | sed 's/[[:space:]]*$//' > {output.bed}
        """

# --- combined sets ---

rule intersection_and_union:
    input:
        expand(f"{introgressed_variants_directory}{{set}}_introgressed_variants_hg19.bed", set = sets)
    output:
        intersection = f"{introgressed_variants_directory}intersection_introgressed_variants_hg19.bed",
        union = f"{introgressed_variants_directory}union_introgressed_variants_hg19.bed"
    resources:
        mem = 5,
        time = "1:00:00"
    shell:
        """
        bedtools multiinter -i {input} | awk '$4 == 4 {{print $1, $2, $3}}' OFS='\\t' > {output.intersection}
        cat {input} | awk '{{print $1, $2, $3}}' OFS='\\t' | sort -V -k1,1 -k2,2n | bedtools merge > {output.union}
        """

rule merge_introgressed_variants:
    input:
        browning = browning_variants,
        sankararaman = sankararaman_variants,
        skov = skov_variants,
        vernot = vernot_variants
    output:
        merged_output
    params:
        python = python_path,
        script = merge_script
    resources:
        mem = 20,
        time = "1:00:00"
    shell:
        """
        {params.python} {params.script} \
            --browning {input.browning} \
            --sankararaman {input.sankararaman} \
            --skov {input.skov} \
            --vernot {input.vernot} \
            --output {output}
        """

# --- gnomAD minor allele frequencies ---

rule quantify_introgressed_variant_mafs:
    input:
        gnomad_vcf = gnomad_vcf,
        browning = browning_variants,
        sankararaman = sankararaman_variants,
        skov = skov_variants,
        vernot = vernot_variants
    output:
        temp(f"{tmp_directory}gnomAD_v4.1.0_chr{{chr}}_introgressed_variant_MAFs.txt")
    wildcard_constraints:
        chr = "|".join(chrs)
    params:
        python = python_path,
        script = mafs_script
    resources:
        mem = 20,
        time = "3:00:00"
    shell:
        """
        {params.python} {params.script} \
            --vcf {input.gnomad_vcf} \
            --chr {wildcards.chr} \
            --variants {input.browning} {input.sankararaman} {input.skov} {input.vernot} \
            --output {output}
        """

rule concat_introgressed_variant_mafs:
    input:
        expand(f"{tmp_directory}gnomAD_v4.1.0_chr{{chr}}_introgressed_variant_MAFs.txt", chr = chrs)
    output:
        maf_output
    resources:
        mem = 8,
        time = "0:45:00"
    shell:
        """
        (
            head -n 1 {input[0]}
            for file in {input}; do
                if [ -s "$file" ]; then
                    tail -n +2 "$file"
                fi
            done
        ) | gzip > {output}
        """
